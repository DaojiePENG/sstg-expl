<?xml version="1.0"?>
<package format="3">
  <name>sstg_system_eval</name>
  <version>0.1.0</version>
  <description>Evaluator-only truth metrics for SSTG system simulation.</description>
  <maintainer email="maintainer@example.invalid">SSTG Team</maintainer>
  <license>LicenseRef-Proprietary-Until-Project-License-Is-Frozen</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>nav_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclpy</depend>
  <depend>ros_gz_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>sstg_gazebo</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
