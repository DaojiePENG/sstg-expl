<?xml version="1.0"?>
<sdf version="1.10">
  <world name="dev_office_01">
    <physics name="physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.35 0.35 0.38 1</ambient>
      <background>0.72 0.78 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <!-- Keep the walking surface exactly at world z=0. -->
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="floor_link">
        <collision name="collision"><geometry><box><size>16 12 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>16 12 0.10</size></box></geometry>
          <material><ambient>0.58 0.58 0.58 1</ambient><diffuse>0.68 0.68 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer boundary. -->
    <model name="wall_north"><static>true</static><pose>0 5.9 1.25 0 0 0</pose><link name="wall"><collision name="c"><geometry><box><size>16 0.2 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>16 0.2 2.5</size></box></geometry><material><ambient>0.76 0.76 0.72 1</ambient><diffuse>0.86 0.86 0.82 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -5.9 1.25 0 0 0</pose><link name="wall"><collision name="c"><geometry><box><size>16 0.2 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>16 0.2 2.5</size></box></geometry><material><ambient>0.76 0.76 0.72 1</ambient><diffuse>0.86 0.86 0.82 1</diffuse></material></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-7.9 0 1.25 0 0 0</pose><link name="wall"><collision name="c"><geometry><box><size>0.2 12 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 12 2.5</size></box></geometry><material><ambient>0.76 0.76 0.72 1</ambient><diffuse>0.86 0.86 0.82 1</diffuse></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>7.9 0 1.25 0 0 0</pose><link name="wall"><collision name="c"><geometry><box><size>0.2 12 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 12 2.5</size></box></geometry><material><ambient>0.76 0.76 0.72 1</ambient><diffuse>0.86 0.86 0.82 1</diffuse></material></visual></link></model>

    <!-- Interior walls leave 1.4-1.6 m door openings and create branches. -->
    <model name="wall_v1_s"><static>true</static><pose>-2 -3.55 1.25 0 0 0</pose><link name="wall"><collision name="c"><geometry><box><size>0.18 4.7 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.18 4.7 2.5</size></box></geometry><material><ambient>0.72 0.72 0.68 1</ambient><diffuse>0.84 0.84 0.80 1</diffuse></material></visual></link></model>
    <model name="wall_v1_n"><static>true</static><pose>-2 3.1 1.25 0 0 0</pose><link name="wall"><collision name="c"><geometry><box><size>0.18 5.6 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.18 5.6 2.5</size></box></geometry><material><ambient>0.72 0.72 0.68 1</ambient><diffuse>0.84 0.84 0.80 1</diffuse></material></visual></link></model>
    <model name="wall_v2_s"><static>true</static><pose>3 -1.95 1.25 0 0 0</pose><link name="wall"><collision name="c"><geometry><box><size>0.18 7.9 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.18 7.9 2.5</size></box></geometry><material><ambient>0.72 0.72 0.68 1</ambient><diffuse>0.84 0.84 0.80 1</diffuse></material></visual></link></model>
    <model name="wall_v2_n"><static>true</static><pose>3 4.7 1.25 0 0 0</pose><link name="wall"><collision name="c"><geometry><box><size>0.18 2.4 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.18 2.4 2.5</size></box></geometry><material><ambient>0.72 0.72 0.68 1</ambient><diffuse>0.84 0.84 0.80 1</diffuse></material></visual></link></model>
    <model name="wall_h1_w"><static>true</static><pose>-5.7 1.25 1.25 0 0 0</pose><link name="wall"><collision name="c"><geometry><box><size>4.4 0.18 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>4.4 0.18 2.5</size></box></geometry><material><ambient>0.72 0.72 0.68 1</ambient><diffuse>0.84 0.84 0.80 1</diffuse></material></visual></link></model>
    <model name="wall_h1_e"><static>true</static><pose>0.35 1.25 1.25 0 0 0</pose><link name="wall"><collision name="c"><geometry><box><size>2.5 0.18 2.5</size></box></geometry></collision><visual name="v"><geometry><box><size>2.5 0.18 2.5</size></box></geometry><material><ambient>0.72 0.72 0.68 1</ambient><diffuse>0.84 0.84 0.80 1</diffuse></material></visual></link></model>

    <!-- Furniture is deliberately simple geometry: collision fidelity and
         controllable occlusion matter more than decorative assets in v0. -->
    <model name="desk_01"><static>true</static><pose>-5.4 -2.4 0.38 0 0 0.2</pose><link name="desk"><collision name="c"><geometry><box><size>1.6 0.8 0.76</size></box></geometry></collision><visual name="v"><geometry><box><size>1.6 0.8 0.76</size></box></geometry><material><ambient>0.34 0.19 0.08 1</ambient><diffuse>0.55 0.32 0.14 1</diffuse></material></visual></link></model>
    <model name="desk_02"><static>true</static><pose>-4.7 3.5 0.38 0 0 -0.1</pose><link name="desk"><collision name="c"><geometry><box><size>1.5 0.8 0.76</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 0.8 0.76</size></box></geometry><material><ambient>0.34 0.19 0.08 1</ambient><diffuse>0.55 0.32 0.14 1</diffuse></material></visual></link></model>
    <model name="meeting_table"><static>true</static><pose>0.4 -2.2 0.38 0 0 0</pose><link name="table"><collision name="c"><geometry><box><size>2.1 1.0 0.76</size></box></geometry></collision><visual name="v"><geometry><box><size>2.1 1.0 0.76</size></box></geometry><material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.42 0.42 0.46 1</diffuse></material></visual></link></model>
    <model name="cabinet_01"><static>true</static><pose>5.9 -4.9 0.9 0 0 0</pose><link name="cabinet"><collision name="c"><geometry><box><size>1.3 0.55 1.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.3 0.55 1.8</size></box></geometry><material><ambient>0.22 0.24 0.26 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material></visual></link></model>
    <model name="cabinet_02"><static>true</static><pose>5.7 4.9 0.9 0 0 0</pose><link name="cabinet"><collision name="c"><geometry><box><size>1.5 0.55 1.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 0.55 1.8</size></box></geometry><material><ambient>0.22 0.24 0.26 1</ambient><diffuse>0.38 0.41 0.45 1</diffuse></material></visual></link></model>
    <model name="island_01"><static>true</static><pose>5.2 0.0 0.55 0 0 0</pose><link name="island"><collision name="c"><geometry><box><size>1.8 1.1 1.1</size></box></geometry></collision><visual name="v"><geometry><box><size>1.8 1.1 1.1</size></box></geometry><material><ambient>0.18 0.29 0.23 1</ambient><diffuse>0.30 0.50 0.39 1</diffuse></material></visual></link></model>

    <!-- Registered task targets. Geometry is evaluator-visible; policy input
         remains LiDAR / camera observations and the online occupancy belief. -->
    <model name="target_panel_01"><static>true</static><pose>-7.76 -2.0 1.05 0 0 0</pose><link name="target"><visual name="v"><geometry><box><size>0.02 0.35 0.35</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>1 0.15 0.15 1</diffuse></material></visual></link></model>
    <model name="target_panel_02"><static>true</static><pose>-1.86 3.9 1.05 0 0 0</pose><link name="target"><visual name="v"><geometry><box><size>0.02 0.35 0.35</size></box></geometry><material><ambient>0.1 0.8 0.2 1</ambient><diffuse>0.15 1 0.25 1</diffuse></material></visual></link></model>
    <model name="target_panel_03"><static>true</static><pose>3.14 -3.6 1.05 0 0 0</pose><link name="target"><visual name="v"><geometry><box><size>0.02 0.35 0.35</size></box></geometry><material><ambient>0.1 0.25 0.9 1</ambient><diffuse>0.15 0.35 1 1</diffuse></material></visual></link></model>
    <model name="target_panel_04"><static>true</static><pose>7.76 3.0 1.05 0 0 3.14159265</pose><link name="target"><visual name="v"><geometry><box><size>0.02 0.35 0.35</size></box></geometry><material><ambient>0.9 0.75 0.1 1</ambient><diffuse>1 0.85 0.15 1</diffuse></material></visual></link></model>
  </world>
</sdf>
