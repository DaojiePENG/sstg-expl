<?xml version="1.0"?>
<package format="3">
  <name>sstg_policy_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 adapter for belief-only incremental SSTG policies.</description>
  <maintainer email="maintainer@example.invalid">SSTG Team</maintainer>
  <license>LicenseRef-Proprietary-Until-Project-License-Is-Frozen</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>sstg_explorer_core</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
